# Copy this file to `.env` in the guardIon folder and paste your keys.
# Restrict keys in Google Cloud: Android key → package + SHA-1; iOS key → bundle ID.
# Must match expo identifiers from app.config.js (default package/bundle: com.guardion.app).

GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Backend API (use your machine IP for physical devices, not localhost)
# Android emulator: http://10.0.2.2:8000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# Google OAuth (from Google Cloud Console → Credentials)
# Web client ID is required for Android; use the same Web ID on backend GOOGLE_WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Must match Google Cloud Web client → Authorized redirect URIs (Expo Go)
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=https://auth.expo.io/@YOUR_EXPO_USERNAME/guardIon
# Optional: defaults to @YOUR_EXPO_USERNAME/guardIon
# EXPO_PUBLIC_EXPO_PROJECT_FULL_NAME=@YOUR_EXPO_USERNAME/guardIon

# Optional: one unrestricted dev key for BOTH platforms (not recommended for production).
# GOOGLE_MAPS_API_KEY=
