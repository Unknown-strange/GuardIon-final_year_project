# Database Configuration
DATABASE_URL=postgresql://guardion_user:your_password@localhost:5432/guardion_dev
DATABASE_URL_TEST=postgresql://guardion_user:your_password@localhost:5432/guardion_test

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-key-change-this-to-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# MQTT Broker Configuration
# Option 1: Local Mosquitto
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false
# Optional TLS client certificates (paths on server)
MQTT_TLS_CA_CERT=
MQTT_TLS_CERT=
MQTT_TLS_KEY=
MQTT_TLS_INSECURE=false

# Option 2: HiveMQ Cloud (uncomment and fill in your credentials)
# MQTT_BROKER_HOST=your-cluster-id.s1.eu.hivemq.cloud
# MQTT_BROKER_PORT=8883
# MQTT_USERNAME=your-hivemq-username
# MQTT_PASSWORD=your-hivemq-password
# MQTT_TLS_ENABLED=true

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Application Settings
DEBUG=true
LOG_LEVEL=DEBUG
APP_NAME=GuardIon API
APP_VERSION=1.0.0

# CORS Settings (Frontend URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:8081

# API Settings
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc

# Device Simulator Settings (for testing without hardware)
SIMULATOR_ENABLED=true
SIMULATOR_DEVICE_COUNT=3
SIMULATOR_UPDATE_INTERVAL=30

# Geofencing Settings
DEFAULT_GEOFENCE_RADIUS=200.0
GEOFENCE_BREACH_COOLDOWN_MINUTES=5

# Alert Settings
ALERT_RETRY_ATTEMPTS=3
ALERT_ESCALATION_MINUTES=5

# Notification Services (Optional - configure when ready)
# Firebase Cloud Messaging
FCM_SERVER_KEY=
EXPO_PUSH_ACCESS_TOKEN=

# Twilio (SMS Notifications)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid (Email Notifications)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Resend (OTP emails)
RESEND_API_KEY=
RESEND_FROM_EMAIL=GuardIon <onboarding@resend.dev>
OTP_LENGTH=5
OTP_EXPIRE_MINUTES=10

# Google OAuth (verify ID tokens from the mobile app)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
# Web client secret — backend only, never put in the mobile app
GOOGLE_CLIENT_SECRET=

# File Upload Settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5

# Background Tasks
ENABLE_BACKGROUND_TASKS=true
HEALTH_CHECK_INTERVAL_MINUTES=5
DATA_CLEANUP_INTERVAL_HOURS=24
DATA_RETENTION_DAYS=90

# Production Settings (change these in production)
# DEBUG=false
# LOG_LEVEL=INFO
# ALLOWED_ORIGINS=https://your-production-domain.com
