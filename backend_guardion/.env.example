# =============================================================================
# Required — copy to Render Environment
# =============================================================================

# Supabase Session pooler (Dashboard → Connect → Session mode, port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Random secret you generate once (32+ chars). Server-only — never put in the mobile app.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# HiveMQ Cloud
MQTT_BROKER_HOST=your-cluster.s1.eu.hivemq.cloud
MQTT_BROKER_PORT=8883
MQTT_USERNAME=your-hivemq-username
MQTT_PASSWORD=your-hivemq-password
MQTT_TLS_ENABLED=true

# Redis (Railway: add Redis plugin, then REDIS_URL=${{Redis.REDIS_URL}})
REDIS_URL=

# API-only service (no MQTT): MQTT_ENABLED=false and run mqtt_worker.py on a second service
MQTT_ENABLED=true

# =============================================================================
# Optional — Google sign-in
# =============================================================================
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# Optional — email OTP (Resend). Without RESEND_API_KEY, OTP is printed to logs in dev.
# =============================================================================
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=GuardIon <onboarding@resend.dev>

# =============================================================================
# Environment-specific
# =============================================================================

# Local
DEBUG=true
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:19006,http://localhost:8081

# Render production
# DEBUG=false
# LOG_LEVEL=INFO
# ALLOWED_ORIGINS=https://your-service.onrender.com
